# Configurações do Banco de Dados
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mautic
MYSQL_USER=mautic
MYSQL_PASSWORD=mauticpassword

# Configurações do Mautic
MAUTIC_SECRET_KEY=your-secret-key-here-change-this
MAUTIC_SITE_URL=http://localhost
MAUTIC_LOCALE=en_US
MAUTIC_TIMEZONE=UTC

# Configurações de Email
MAUTIC_MAILER_DSN=smtp://localhost:1025

# Configurações de Mensageria (filas)
MAUTIC_MESSENGER_DSN_EMAIL=doctrine://default?queue_name=email
MAUTIC_MESSENGER_DSN_HIT=doctrine://default?queue_name=hit
MAUTIC_MESSENGER_DSN_FAILED=doctrine://default?queue_name=failed

# Configurações de Sessão
MAUTIC_SESSION_NAME=MAUTICSESSID

# Configurações de Contexto de Requisição
MAUTIC_REQUEST_CONTEXT_HOST=localhost
MAUTIC_REQUEST_CONTEXT_SCHEME=http
MAUTIC_REQUEST_CONTEXT_BASE_URL=
MAUTIC_REQUEST_CONTEXT_HTTP_PORT=80
MAUTIC_REQUEST_CONTEXT_HTTPS_PORT=443

# Configurações de Migração
MAUTIC_MIGRATIONS_TABLE_NAME=migrations

# Configurações do ElFinder
MAUTIC_EL_FINDER_URL=
MAUTIC_EL_FINDER_PATH=

# Ambiente
APP_ENV=prod
APP_DEBUG=0

# Configurações Opcionais
CLEAR_CACHE=false

